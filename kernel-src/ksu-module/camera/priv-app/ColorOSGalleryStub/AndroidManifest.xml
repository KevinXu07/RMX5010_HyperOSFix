<?xml version="1.0" encoding="utf-8"?>
<!--
  com.coloros.gallery3d metadata stub for OplusCamera.

  OplusCamera reads this package's meta-data through
  getPackageInfo("com.coloros.gallery3d", 0x80) and NPEs when the package is
  absent.  The package supplies metadata only (android:hasCode="false"); it
  deliberately has no activity and no MAIN/LAUNCHER intent-filter, so it never
  puts a "Gallery" icon on the home screen.

  Rebuild with scripts/build_gallery_stub.sh.  Keep the signing key (Android
  debug) unchanged: the installed update must be signed by the same key.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.coloros.gallery3d"
    android:versionCode="3"
    android:versionName="1.2">
    <uses-sdk android:minSdkVersion="35" android:targetSdkVersion="36" />
    <application android:label="Gallery" android:hasCode="false">
        <meta-data android:name="isIntegrationUITransitionSupported" android:value="false" />
        <meta-data android:name="isSupportBlurEdit" android:value="false" />
        <meta-data android:name="isSupportEarlyStart" android:value="false" />
        <meta-data android:name="isSupportAIIDPhoto" android:value="false" />
        <meta-data android:name="isSupportMediaInfoInsert" android:value="false" />
    </application>
</manifest>
