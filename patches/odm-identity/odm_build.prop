# --- RMX5010_HyperOSFix identity fix (nezha mainline) ---
# 切断 OnePlus/PJA110 import 链（/odm/etc/${ro.boot.prjname}/… 与 /mnt/vendor/my_manifest/build.prop）。
# 那份 my_manifest 是 OnePlus Ace 3 Pro(PJA110) 的身份块：ro.product.odm.model=PJA110、
# ro.product.manufacturer=OnePlus、ro.build.fingerprint=OnePlus/PJA110/OP5943L1:13/… 全部由它注入。
ro.product.manufacturer=Xiaomi
ro.product.odm.manufacturer=Xiaomi
ro.product.brand=Xiaomi
ro.product.odm.brand=Xiaomi
ro.product.model=2410DPN6CC
ro.product.odm.model=2410DPN6CC
ro.product.device=nezha
