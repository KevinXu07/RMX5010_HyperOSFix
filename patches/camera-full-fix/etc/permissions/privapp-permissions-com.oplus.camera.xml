<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <!--
      OplusCamera is promoted from the RMX my_product/app location to product/priv-app.
      Listing every requested permission is intentional: PackageManager only applies
      entries that are privileged permissions on this HyperOS build, while avoiding
      fatal privapp-enforcement omissions as the platform permission set changes.
    -->
